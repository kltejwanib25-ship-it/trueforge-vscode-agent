{
    "description":  "coding assistant for VS-Code Extention",
    "name":  "forge-code-agent",
    "manifest":  {
                     "model":  {
                                   "name":  "google-gemini/gemini-3-1-flash-lite",
                                   "params":  {
                                                  "reasoning_effort":  "medium"
                                              }
                               },
                     "instructions": "For coding requests, use workspace tools to find and read relevant files.\nFollow existing project conventions and choose implementation, test, and documentation files yourself.\nBefore editing, read the surrounding code, including decorators and function boundaries. Preserve existing commands, decorators, and tests unless the task requires changing them.\nFor CLI tests, inspect how existing tests invoke built-in commands and reuse that approach.\nUse propose_edit for changes and let the user review each hunk. Respect rejected edits.\nAfter an accepted edit, read the affected section again to check placement and completeness.\nContinue through all requested files without asking the user to choose routine implementation details.\nThe run_terminal tool currently supports only git status. Report tests as unverified unless you have actual test results.\nIf a tool or model fails, explain the specific blocker and any work still pending.",
                     "mcp_servers":  [
                                         {
                                             "name":  "vscode-workspace",
                                             "enable_tools":  [
                                                                  "find_files",
                                                                  "read_file",
                                                                  "search_text",
                                                                  "propose_edit",
                                                                  "run_terminal"
                                                              ],
                                             "disable_tools":  [

                                                               ],
                                             "preload_tools":  [

                                                               ],
                                             "require_approval_for_tools":  [
                                                                                "@write",
                                                                                "@destructive"
                                                                            ],
                                             "preload":  false
                                         }
                                     ],
                     "config":  {
                                    "iteration_limit":  512,
                                    "sandbox":  {
                                                    "enabled":  false,
                                                    "file_downloads":  true
                                                },
                                    "dynamic_sub_agents":  {
                                                               "enabled":  true
                                                           },
                                    "context_management":  {
                                                               "compaction":  {
                                                                                  "enabled":  true
                                                                              },
                                                               "large_tool_response":  {
                                                                                           "enabled":  true
                                                                                       }
                                                           },
                                    "generative_ui":  {
                                                          "enabled":  true
                                                      },
                                    "ask_user_questions":  {
                                                               "enabled":  false
                                                           },
                                    "web_search":  {
                                                       "enabled":  false
                                                   }
                                }
                 }
}